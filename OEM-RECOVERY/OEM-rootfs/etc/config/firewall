# allow IPsec/ESP and ISAKMP passthrough
config rule
	option src		wandfroute
	option dest		lan
	option proto		esp
	option target		ACCEPT

config rule
	option src		wandfroute
	option dest		lan
	option dest_port	500
	option proto		udp
	option target		ACCEPT

