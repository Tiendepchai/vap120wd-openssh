#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

start_service() {

	procd_open_instance
	procd_set_param command /bin/sh "/lib/obuspa/obuspa_check_hang.sh"
	procd_set_param respawn
	procd_close_instance
}

stop_service() {
    p=$(ps | grep /lib/obuspa/obuspa_check_hang.sh | grep -v grep | awk '{print $1}')
    kill $p
}

reload_service() {
	stop
	start
}
