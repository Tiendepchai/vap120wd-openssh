#!/bin/sh /etc/rc.common
# Copyright (C) 2006-2011 OpenWrt.org

START=10
STOP=98

uci_apply_defaults() {
	. /lib/functions/system.sh

	cd /etc/uci-defaults || return 0
	files="$(ls)"
	[ -z "$files" ] && return 0
	mkdir -p /tmp/.uci
	for file in $files; do
	# AP-838: check file ext to support execute lua
		# ( . "./$(basename $file)" ) && rm -f "$file"
		ext=`basename "$file" | awk -F. '{print $NF}'`
		if [ "$ext" == "default-lua" ];then
			/usr/bin/lua "$file"
		else
			( . "./$(basename $file)" )
		fi && rm -f "$file"
	done
	uci commit
}

boot() {
	[ -f /proc/mounts ] || /sbin/mount_root
	[ -f /proc/jffs2_bbc ] && echo "S" > /proc/jffs2_bbc
	[ -f /proc/net/vlan/config ] && vconfig set_name_type DEV_PLUS_VID_NO_PAD

	mkdir -p /var/run
	mkdir -p /var/log
	mkdir -p /var/lock
	mkdir -p /var/state
	mkdir -p /tmp/.uci
	chmod 0700 /tmp/.uci
	mkdir -p /tmp/.jail
	touch /var/log/wtmp
	touch /var/log/lastlog
	touch /tmp/resolv.conf.auto
	ln -sf /tmp/resolv.conf.auto /tmp/resolv.conf
	grep -q debugfs /proc/filesystems && /bin/mount -o noatime -t debugfs debugfs /sys/kernel/debug
	[ "$FAILSAFE" = "true" ] && touch /tmp/.failsafe

	/sbin/kmodloader
	#AP-335: Rearrange module Log
	mkdir /data
	/bin/mount -t jffs2 -o noatime /dev/mtdblock8 /data
	mkdir /data/log
	
	#init button
	button 15 &

	#flash w Factory 0 0x15 0x76 0xa0 0x00
  	# get Mac from Flash (Factory partiontion, offset=4, len=6)
  	setMACWLan

	# allow wifi modules time to settle
	sleep 1

	/sbin/wifi detect > /tmp/wireless.tmp
	[ -s /tmp/wireless.tmp ] && {
		cat /tmp/wireless.tmp >> /etc/config/wireless
	}
	rm -f /tmp/wireless.tmp

	/bin/board_detect
	uci_apply_defaults
	
	# temporary hack until configd exists
	/sbin/reload_config

	# create /dev/root if it doesn't exist
	[ -e /dev/root -o -h /dev/root ] || {
		rootdev=$(awk 'BEGIN { RS=" "; FS="="; } $1 == "root" { print $2 }' < /proc/cmdline)
		[ -n "$rootdev" ] && ln -s "$rootdev" /dev/root
	}

	#dat2uci
	dat2uci -l /etc/wireless/l1profile.dat -u /etc/config/wireless

	#set defaul ssid
	setSSIDWLan

	#get config reset
	getCfgRst
	#check statevalue
	local statevalue=`sysHwInfo statevalue r`
    if [[ "$statevalue" == "1" ]]; then
		uci set firewall.ssh_lan_reject.enabled='1'
		uci set firewall.telnet_lan_reject.enabled='1'
		uci commit
    else
		uci set firewall.ssh_lan_reject.enabled='0'
		uci set firewall.telnet_lan_reject.enabled='0'
		uci commit
    fi

	#set password user admin
	setpassadmin

	# do lock / unlock
	[ -f "/usr/bin/lock/generate_lock_config.sh" ] && {
		lock_status=$(cof_cli read LockStatus)
		if [ "$lock_status" = "1" ];then
			/usr/bin/dns_parser &
		fi
	}
}
